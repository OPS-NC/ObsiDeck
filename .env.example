# Copy to .env and adjust. Read by `docker compose` (host side).

# Host path of the Obsidian vault (bind-mounted to /vault in the container). Required.
# iCloud vault on macOS: "/Users/<you>/Library/Mobile Documents/iCloud~md~obsidian/Documents"
OBSIDIAN_VAULT_HOST_PATH="/path/to/your/vault"

# Image tag to run (latest = main branch, or a release such as 0.1).
OBSIDECK_VERSION=latest

# URL prefix. The published image is built for /obsideck: any other value requires
# building from source (docker-compose.build.yml) and editing infra/envoy/envoy.yaml.
OBSIDECK_BASE_PATH=/obsideck

# Host port published by Envoy, bound to 127.0.0.1 only (Tailscale Serve proxies to it).
OBSIDECK_HTTP_PORT=8088

# Name displayed in the sidebar.
OBSIDECK_VAULT_NAME=Obsidian

# UID/GID the app runs as inside the container. On macOS (Docker Desktop /
# OrbStack) the default works; on Linux, use the vault owner's ids (`id -u`, `id -g`).
OBSIDECK_UID=1000
OBSIDECK_GID=1000

# Set to true if filesystem events are not propagated into the container
# (some network/virtualized filesystems). Polling costs more CPU.
OBSIDECK_WATCH_POLLING=false
OBSIDECK_POLL_INTERVAL=1000

# App-level settings (inside the container; already set by docker-compose.yml):
# OBSIDIAN_VAULT_PATH=/vault
# PORT=3000
